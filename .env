# .env
# --- Flask Configuration ---
# Generate a strong, random secret key for production environments.
# You can generate one using Python: python -c 'import secrets; print(secrets.token_hex(16))'
SECRET_KEY=akdavid_hotel_booking_secret_key_replace_this_in_prod

# --- Flask-Mail Configuration ---
# Replace with your actual email provider's SMTP server details
HOTEL_NAME=Your Hotel Name Here
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
# Your email address (the account that will send the emails)
MAIL_USERNAME=akdavid4real@gmail.com
# Your email password or App Password (recommended for Gmail)
# IMPORTANT: For Gmail, you'll likely need to generate an "App Password"
# See: https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=nscl rctz nzax pkbn
# Use TLS (Transport Layer Security) - True for port 587 with most providers like Gmail
MAIL_USE_TLS=False
# Use SSL (Secure Sockets Layer) - Usually False if MAIL_USE_TLS is True
MAIL_USE_SSL=True
# The "From" address shown in the emails (can be the same as MAIL_USERNAME)
MAIL_DEFAULT_SENDER=akdavid4real@gmail.com

# --- Application Specific Configuration ---
# The email address where booking notifications should be sent (the hotel's inbox)
HOTEL_EMAIL=akdavid170@gmail.com

# Note: Keep this file secure and do not commit it to public repositories.
# Add `.env` to your `.gitignore` file.

